{
  "name": "makefile-runner",
  "displayName": "Makefile Runner",
  "description": "A lightweight VS Code extension that automatically discovers Makefile targets and lets you run them instantly through a searchable Quick Pick interface with live updates and multi-root workspace support.",
  "version": "1.0.0",
  "publisher": "e-kacaj",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "make",
    "makefile",
    "tasks",
    "build",
    "runner",
    "automation"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "makefileRunner.quickPick",
        "title": "Makefile: Run Target"
      },
      {
        "command": "makefileRunner.refreshTargets",
        "title": "Makefile: Refresh Targets"
      },
      {
        "command": "makefileRunner.createDefaultMakefile",
        "title": "Makefile: Create Default Makefile"
      },
      {
        "command": "makefileRunner.runTarget",
        "title": "Makefile: Run Target"
      }
    ],
    "keybindings": [
      {
        "command": "makefileRunner.quickPick",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "config.makefileRunner.showQuickPick == true"
      },
      {
        "command": "makefileRunner.refreshTargets",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m"
      },
      {
        "command": "makefileRunner.createDefaultMakefile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "makefileRunner.quickPick",
          "when": "config.makefileRunner.showQuickPick == true"
        },
        {
          "command": "makefileRunner.runTarget",
          "when": "false"
        },
        {
          "command": "makefileRunner.runTargetFromCommandCenter",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "makefileRunner",
          "title": "Makefile Runner",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "makefileRunner.treeView",
          "name": "Makefile Targets",
          "when": "config.makefileRunner.showTreeView == true",
          "icon": "images/icon.svg"
        }
      ],
      "makefileRunner": [
        {
          "id": "makefileRunner.commandCenter",
          "name": "Commands",
          "icon": "images/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Makefile Runner",
      "properties": {
        "makefileRunner.makefilePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional Makefile paths or glob patterns to include in discovery (e.g. \"infra/Makefile\" or \"**/docker/Makefile\")."
        },
        "makefileRunner.excludePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Folder names or glob patterns to exclude from Makefile discovery. Simple names like \".venv\" or \"vendor\" are merged with the built-in excludes (.git, node_modules, dist …). Full globs like \"**/docs/**\" are also supported."
        },
        "makefileRunner.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh cached targets when Makefile change."
        },
        "makefileRunner.groupBy": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "workspace",
            "makefile"
          ],
          "description": "How to group targets in Quick Pick. Use 'none' for a flat list, 'workspace' to group by workspace folder, or 'makefile' to group by Makefile path."
        },
        "makefileRunner.showPrivateTargets": {
          "type": "boolean",
          "default": false,
          "description": "Show targets starting with '_' in Quick Pick."
        },
        "makefileRunner.terminalReuse": {
          "type": "boolean",
          "default": true,
          "description": "Reuse an existing terminal per workspace when running targets."
        },
        "makefileRunner.groupByWorkspace": {
          "type": "boolean",
          "default": false,
          "markdownDeprecationMessage": "Deprecated in favor of `makefileRunner.groupBy`. If enabled, it is treated as `groupBy: workspace` when `groupBy` is not set.",
          "description": "Deprecated: use makefileRunner.groupBy instead."
        },
        "makefileRunner.defaultMakefileTemplate": {
          "default": {
            "build": "@echo \"Build step\"",
            "test": "@echo \"Test step\"",
            "clean": "@echo \"Clean step\""
          },
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ],
          "description": "Template used when creating a new Makefile. Can be a raw string or an object of target-to-command values."
        },
        "makefileRunner.showQuickPick": {
          "type": "boolean",
          "default": true,
          "description": "Show the Quick Pick command and shortcut for selecting a Makefile target to run."
        },
        "makefileRunner.showTreeView": {
          "type": "boolean",
          "default": false,
          "description": "Show Makefile targets in a tree view in the Explorer sidebar."
        },
        "makefileRunner.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging for Makefile Runner."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/e.kacaj/makefile-runner"
  },
  "bugs": {
    "url": "https://gitlab.com/e.kacaj/makefile-runner/-/issues"
  },
  "homepage": "https://gitlab.com/e.kacaj/makefile-runner",
  "author": {
    "name": "Edmond Kacaj",
    "email": "info@edmondkacaj.com"
  },
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
